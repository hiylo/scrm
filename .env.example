#
# 用法: cp .env.example .env 后按需改值。docker compose 会自动读取同目录 .env。
# 本文件里的每个默认值都是「故意不可用于生产」的占位符:
#   - 不写任何一项也能起: docker-compose.yml 对每个变量都给了同样的 dev 占位默认值,
#     dev profile 下启动校验只告警不阻断。
#   - SPRING_PROFILES_ACTIVE=prod 时, 下方三个 fail-closed 校验会直接拒绝启动。
# 密钥生成示例: openssl rand -base64 32

# ========== 数据库 ==========
# 对应 docker-compose.yml 的 POSTGRES_PASSWORD 与 SPRING_DATASOURCE_PASSWORD
POSTGRES_PASSWORD=change-me-postgres

# ========== 对象存储 (SCRM_STORAGE_PROVIDER=minio 时生效) ==========
MINIO_ROOT_USER=scrm
MINIO_ROOT_PASSWORD=change-me-minio

# ========== 以下三项在非 dev/local/test profile 下会阻断启动 ==========

# JWT 签名密钥。约束来自 JwtTokenProvider:
#   1) UTF-8 字节数 >= 32, 否则 WeakKeyException;
#   2) 不得以 "scrm-dev-only-" 开头 —— 该前缀是内置 dev 默认值的特征, prod 下命中即拒绝启动。
SCRM_JWT_SECRET=change-me-to-at-least-32-bytes-of-random-0123456789

# 敏感字段落库加密密钥 (AesGcmUtils 做 AES-GCM)。
# 必须是「合法 Base64 且解码后 16/24/32 字节」: AesGcmUtils 用 Base64.getDecoder()
# 解这个值, 含 - _ ! 等非标准 Base64 字符会在首次写入加密字段时抛
# IllegalArgumentException; 长度不是 16/24/32 字节则 SecretKeySpec 报错。
# 生成: openssl rand -base64 32
# 留空时 dev profile 明文落库 (PLAIN: 前缀) 并告警, prod 直接拒绝启动。
SCRM_ACCOUNT_ENCRYPTION_KEY=c2NybS1kZXYtYWVzLTI1Ni1rZXktY2hhbmdlLW1lISE=

# 回调共享密钥, scrm-server 以 X-Agent-Secret 头携带 (/scrm/callback/**, /scrm/webhooks/**)。
# 留空时 dev profile 告警, prod 拒绝启动 (CallbackSecretStartupValidator)。
SCRM_CALLBACK_AGENT_SECRET=change-me-callback-shared-secret

# ========== 可选开关 ==========
# 默认 dev。设为 prod 会启用上面三项 fail-closed 校验。
SPRING_PROFILES_ACTIVE=dev

# 企业微信: 无真实企业凭据时保持 mock
WEWORK_MOCK_MODE=true
WEWORK_REAL_API_ENABLED=false

# AI 能力 (ScrmAiAssistantService 的回复生成目前仍为占位实现, 打开前先确认下游可用)
SCRM_AI_ENABLED=false

# 分布式 ID (多实例部署时每个实例的 WORKER_ID 必须互不相同)
SEQUENCE_WORKER_ID=1
SEQUENCE_DATACENTER_ID=1

# ========== 前端 (不参与 docker compose, 由 Vite 在构建期读取) ==========
# 放在 frontend/.env 里, 且只对 `npm run build` 生效 (Vite 是构建期注入, 不是运行期)。
# 两项都留空时前端回落到 window.location.host —— 反代部署下这才是想要的行为,
# 因此 frontend/Dockerfile 的 .dockerignore 故意不把 .env 烧进镜像。
# VITE_API_BASE_URL=
# VITE_SCRM_WS_HOST=
